{% extends 'themes/base_visitor.html.twig' %}

{% block title %}Panier{% endblock %}

{% block description %}Panier{% endblock %}

{% block keywords %}Panier, produits{% endblock %}

{% block main %}

    {% if cartItems is empty %}
        <div class="container mt-5">
            <div class="row">
                <div class="col-12 text-center">
                    <h1 class="display-2 mb-3">Votre panier est vide</h1>
                    <p class="lead mb-5">Commencez votre shopping dès maintenant à travers nos articles</p>
                    <a href="{{ path('visitor_catalog_index') }}" class="btn btn shadow" style="background-color: #C59B76">Commandez votre bonheur</a>
                </div>
            </div>
        </div>
    {% else %}
        <h1 class="text-center my-4 display-2">Panier</h1>

        <div class="container my-5">
            <div class="row justify-content-center">
                <div class="col-md-10">
                    <div class="card border p-3 rounded bg-white text-dark">
                        <div class="card-body">
                            {% for cartItem in cartItems %}
                                <div class="d-flex flex-column flex-md-row align-items-center mb-4 border-bottom pb-3">
                                    <img src="{{ vich_uploader_asset(cartItem.product, 'imageFile') }}" alt="{{ cartItem.product.name }}" class="img-fluid mx-3 mb-md-0" style="max-width: 150px; height: auto;">
                                        <p class="m-auto p-2 text-center"><strong>{{ cartItem.product.name }}</strong></p>
                                        <div class="d-flex justify-content-center align-items-center">
                                            <a href="{{path('visitor_decrement_cart', {'id': cartItem.product.id})}}" class="btn btn-sm" style="background-color: #C59B76">
                                                <i class="fa-solid fa-minus"></i>
                                            </a> 
                                            <span class="m-2">{{ cartItem.quantity }}</span>
                                            <a href="{{path('visitor_add_cart', {'id': cartItem.product.id})}}" class="btn btn-sm" style="background-color: #C59B76">
                                                <i class="fa-solid fa-plus"></i>
                                            </a>
                                        </div>
                                            <p class="m-auto p-2 text-center"><strong>Prix unitaire : {{ cartItem.product.price }} €</strong> </p>
                                            <p class="m-auto p-2 text-center"><strong>Prix TTC : {{ cartItem.getAmount }} €</strong></p>  
                                            <div class="d-flex justify-content-center align-items-center m-3">
                                                <a href="{{path('visitor_remove_cart', {'id': cartItem.product.id})}}" class="btn btn-sm btn-danger m-2">
                                                    <i class="fa-solid fa-trash mx-2"></i>Retirer
                                                </a>
                                            </div> 
                                
                                </div>
                            {% endfor %}
                        </div>
                        <div class="card-footer d-flex flex-column flex-md-row justify-content-between align-items-center">
                            <a href="{{path('app_order_index')}}" class="btn btn my-2" style="background-color: #C59B76">Passer commande</a>
                            <h4 class="my-3"><strong>Total TTC : {{ cartTotalAmount }} €</strong></h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

{% endblock %}